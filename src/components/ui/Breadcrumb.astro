---
import { SITE_URL } from '../../lib/constants';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

// Generate BreadcrumbList JSON-LD schema
const schemaData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => {
    const element: Record<string, any> = {
      "@type": "ListItem",
      "position": index + 1,
      "name": item.label
    };
    if (item.href) {
      // Build absolute URL for schema
      element.item = item.href.startsWith('http') ? item.href : `${SITE_URL}${item.href}`;
    } else {
      // Current page fallback
      element.item = SITE_URL;
    }
    return element;
  })
};
---

<nav aria-label="Breadcrumb" class="py-4">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-stone-500">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center gap-2">
          {index > 0 && <span class="text-stone-300 font-light" aria-hidden="true">/</span>}
          {isLast || !item.href ? (
            <span class="font-medium text-stone-800" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a
              href={item.href}
              class="hover:text-accent-600 transition-colors duration-150"
            >
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
