---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import AgentCard from '../components/ui/AgentCard.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import SimilarProperties from '../components/property/SimilarProperties.astro';
import PropertySchema from '../components/seo/PropertySchema.astro';
import SEOHead from '../components/seo/SEOHead.astro';

interface Props {
  property: any; // The full content collection entry
}

const { property } = Astro.props;
const { data, id } = property;

const propertySlug = data.slug || id;
const absoluteUrl = `${Astro.site}properties/${propertySlug}/`;

// Format breadcrumb items
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Properties', href: '/properties/' },
  { label: 'Detail', href: undefined } // Last item is current page
];

const ogImage = data.featured_image?.src;
---

<BaseLayout title={data.title} description={data.description}>
  <!-- Injects specific SEO Head elements into BaseLayout -->
  <Fragment slot="head">
    <SEOHead
      title={data.title}
      description={data.description}
      image={ogImage}
      canonicalUrl={absoluteUrl}
      type="article"
    />
    <PropertySchema property={property} url={absoluteUrl} />
  </Fragment>

  <div class="bg-stone-50 py-6 md:py-10">
    <div class="container-site">
      <!-- Breadcrumbs -->
      <Breadcrumb items={breadcrumbItems} />

      <!-- Title & Price Header (Mobile and Desktop combined) -->
      <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 mb-8">
        <div class="space-y-2">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-display text-stone-900 tracking-tight leading-tight">
            {data.title}
          </h1>
          <p class="text-sm text-stone-500 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0 text-stone-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>{data.address}, {data.location}, {data.city}, {data.state} - {data.postal_code}</span>
          </p>
        </div>

        <div class="md:text-right shrink-0 bg-white border border-stone-200/50 p-4 rounded-xl shadow-sm min-w-[200px] flex md:flex-col justify-between items-center md:items-end gap-2">
          <span class="text-[10px] text-stone-400 uppercase tracking-widest font-bold">Quote Price</span>
          <span class="text-2xl md:text-3xl font-extrabold font-display text-accent-700">
            {data.listing_type === 'rent' ? (
              `${new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 0 }).format(data.price)} / month`
            ) : (
              new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 0 }).format(data.price)
            )}
          </span>
        </div>
      </div>

      <!-- Main Columns Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Main Column (Gallery, Specs, Features, Map) -->
        <div class="lg:col-span-8 space-y-8">
          <slot />
        </div>

        <!-- Right Sidebar Column (Agent, Contact) -->
        <aside class="lg:col-span-4 space-y-6">
          <div class="sticky top-24 space-y-6">
            <!-- Agent Card -->
            <AgentCard
              agentName={data.agent_name}
              agentPhone={data.agent_phone}
              agentEmail={data.agent_email}
            />

            <!-- Contact Form -->
            <div class="bg-white rounded-xl border border-stone-100 p-6 shadow-sm">
              <h3 class="text-base font-bold font-display text-stone-900 mb-4">Send an Inquiry</h3>
              <ContactForm
                propertyTitle={data.title}
                propertyId={data.property_id}
                flat={true}
              />
            </div>
          </div>
        </aside>
      </div>

      <!-- Similar Properties Row (Full-width below columns) -->
      <div class="mt-16 md:mt-24 border-t border-stone-200/60 pt-16">
        <SimilarProperties
          currentSlug={propertySlug}
          propertyType={data.property_type}
          city={data.city}
        />
      </div>
    </div>
  </div>
</BaseLayout>
