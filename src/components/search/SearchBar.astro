---
import { PROPERTY_TYPES } from '../../lib/constants';
import Button from '../ui/Button.astro';
import { getCollection } from 'astro:content';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Fetch all listings to extract unique locations dynamically
const properties = await getCollection('properties');
const uniqueLocations = [...new Set(properties.map((p) => p.data.location))]
  .filter(Boolean)
  .sort((a, b) => a.localeCompare(b));
---

<form
  method="GET"
  action="/properties/"
  class={`w-full bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-4 md:p-6 shadow-xl flex flex-col gap-4 md:flex-row md:items-center ${className}`}
>
  <!-- Listing Type Radio Toggle (Buy / Rent) -->
  <div class="flex flex-col gap-1.5 shrink-0">
    <span class="text-xs font-semibold text-white uppercase tracking-wider">I want to:</span>
    <div class="flex bg-white/10 border border-white/10 p-1 rounded-lg select-none">
      <label class="relative flex-1 text-center cursor-pointer">
        <input
          type="radio"
          name="listing_type"
          value="buy"
          checked
          class="peer sr-only"
        />
        <span class="block px-4 py-2 text-xs font-bold text-stone-300 rounded-md peer-checked:bg-white peer-checked:text-stone-900 peer-checked:shadow-sm hover:text-white transition-all">
          Buy
        </span>
      </label>
      <label class="relative flex-1 text-center cursor-pointer">
        <input
          type="radio"
          name="listing_type"
          value="rent"
          class="peer sr-only"
        />
        <span class="block px-4 py-2 text-xs font-bold text-stone-300 rounded-md peer-checked:bg-white peer-checked:text-stone-900 peer-checked:shadow-sm hover:text-white transition-all">
          Rent
        </span>
      </label>
    </div>
  </div>

  <!-- Divider on Desktop -->
  <div class="hidden md:block h-12 w-px bg-white/20 shrink-0"></div>

  <!-- Property Type Dropdown -->
  <div class="flex-1 flex flex-col gap-1.5">
    <label for="search-type" class="text-xs font-semibold text-white uppercase tracking-wider">Property Type</label>
    <select
      name="type"
      id="search-type"
      class="w-full bg-white/15 border border-white/10 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 font-medium transition-all"
    >
      <option value="" class="text-stone-900">All Types</option>
      {PROPERTY_TYPES.map((type) => (
        <option value={type.value} class="text-stone-900">
          {type.icon} {type.label}
        </option>
      ))}
    </select>
  </div>

  <!-- Divider on Desktop -->
  <div class="hidden md:block h-12 w-px bg-white/20 shrink-0"></div>

  <!-- Location Input with Custom Dropdown suggestions -->
  <div class="flex-1 flex flex-col gap-1.5 relative" data-location-search-container data-locations={JSON.stringify(uniqueLocations)}>
    <label for="search-location" class="text-xs font-semibold text-white uppercase tracking-wider">Location</label>
    <div class="relative">
      <input
        type="text"
        name="location"
        id="search-location"
        placeholder="Enter city or area..."
        class="w-full bg-white/15 border border-white/10 text-white placeholder-white/50 rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 font-medium transition-all"
        autocomplete="off"
      />
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="w-4 h-4 text-white/50 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
      </svg>
    </div>
    
    <!-- Suggestions Dropdown -->
    <div
      id="search-location-dropdown"
      class="hidden absolute z-50 left-0 right-0 top-full mt-1.5 bg-stone-900 border border-stone-800 rounded-xl shadow-2xl overflow-hidden max-h-60 overflow-y-auto text-xs font-semibold py-1 divide-y divide-stone-850"
    >
    </div>
  </div>

  <!-- Submit Button -->
  <div class="md:self-end mt-2 md:mt-0">
    <Button type="submit" variant="primary" class="w-full md:w-auto h-[38px] cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637z" />
      </svg>
      <span>Search</span>
    </Button>
  </div>
</form>

<script is:inline>
  function initLocationAutocomplete() {
    const container = document.querySelector('[data-location-search-container]');
    if (!container) return;

    const input = container.querySelector('#search-location');
    const dropdown = container.querySelector('#search-location-dropdown');
    if (!input || !dropdown) return;

    const locations = JSON.parse(container.getAttribute('data-locations') || '[]');
    let activeIndex = -1;

    function renderDropdown(items) {
      if (items.length === 0) {
        dropdown.classList.add('hidden');
        return;
      }
      dropdown.innerHTML = items
        .map(
          (item, index) => `
          <button
            type="button"
            data-index="${index}"
            class="w-full text-left px-4 py-2.5 hover:bg-accent-600 hover:text-white text-stone-300 flex items-center gap-2 cursor-pointer transition-colors duration-150 font-sans"
          >
            <svg class="w-3.5 h-3.5 opacity-60 text-accent-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>${item}</span>
          </button>
        `
        )
        .join('');
      dropdown.classList.remove('hidden');
    }

    input.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      activeIndex = -1;
      if (!query) {
        dropdown.classList.add('hidden');
        return;
      }
      const filtered = locations.filter((loc) => loc.toLowerCase().includes(query));
      renderDropdown(filtered);
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });

    // Click selection
    dropdown.addEventListener('click', (e) => {
      const btn = e.target.closest('button');
      if (btn) {
        const value = btn.querySelector('span').textContent;
        input.value = value;
        dropdown.classList.add('hidden');
      }
    });

    // Keyboard support
    input.addEventListener('keydown', (e) => {
      const items = dropdown.querySelectorAll('button');
      if (dropdown.classList.contains('hidden')) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % items.length;
        updateActiveState(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        updateActiveState(items);
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0 && activeIndex < items.length) {
          e.preventDefault();
          input.value = items[activeIndex].querySelector('span').textContent;
          dropdown.classList.add('hidden');
        }
      } else if (e.key === 'Escape') {
        dropdown.classList.add('hidden');
      }
    });

    function updateActiveState(items) {
      items.forEach((item, index) => {
        if (index === activeIndex) {
          item.classList.add('bg-accent-600', 'text-white');
          item.classList.remove('text-stone-300');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-accent-600', 'text-white');
          item.classList.add('text-stone-300');
        }
      });
    }
  }

  // Set up on DOM load & Astro transitions
  document.addEventListener('DOMContentLoaded', initLocationAutocomplete);
  document.addEventListener('astro:after-swap', initLocationAutocomplete);
</script>
