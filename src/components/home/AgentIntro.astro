---
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import agentPhoto from '../../assets/images/agent-rajesh.png';

// Fetch the agent profile entry
const entry = await getEntry('settings', 'agent-profile');
const agent = entry?.data || {
  agent_name: 'Rajesh Kumar',
  agent_designation: 'Senior Property Consultant',
  experience_years: 15,
  properties_sold: 500,
  bio: 'With over 15 years of experience in the real estate industry, I have helped hundreds of families find their dream homes and guided investors to make smart property decisions.',
  agent_phone: '+91 98765 43210',
  agent_email: 'rajesh@premierproperties.in',
};
---

<section class="section-spacing bg-stone-50 border-y border-stone-200/50">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Agent Photo Frame -->
      <div class="lg:col-span-5 flex justify-center relative">
        <!-- Ambient backing card -->
        <div class="absolute -inset-4 bg-accent-100/50 rounded-[2rem] -rotate-2 pointer-events-none"></div>
        
        <div class="relative rounded-2xl overflow-hidden aspect-[4/5] w-full max-w-[380px] shadow-xl border-[6px] border-white bg-stone-200">
          <Picture
            src={agentPhoto}
            widths={[380, 760]}
            sizes="(max-width: 768px) 380px, 380px"
            formats={['avif', 'webp']}
            alt={agent.agent_name}
            class="w-full h-full object-cover"
            loading="lazy"
          />
          
          <!-- Experience Badge Overlay -->
          <div class="absolute bottom-4 left-4 bg-accent-900/90 backdrop-blur-sm border border-accent-500/30 text-white px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow-md">
            <span class="w-2 h-2 rounded-full bg-green-400"></span>
            <span class="text-[10px] font-bold uppercase tracking-wider">Verified Agent</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Info & Stats -->
      <div class="lg:col-span-7 space-y-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-accent-700 uppercase tracking-widest">
            <span>Direct Consulting Access</span>
          </div>
          
          <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-stone-900 tracking-tight">
            Meet {agent.agent_name}
          </h2>
          
          <p class="text-accent-800 text-sm font-semibold tracking-wide uppercase">
            {agent.agent_designation}
          </p>

          <p class="text-stone-600 text-base leading-relaxed font-sans pt-2">
            {agent.bio}
          </p>
        </div>

        <!-- Trust Stats Row -->
        <div class="grid grid-cols-3 gap-4 pt-4 border-t border-stone-200">
          <div class="bg-white rounded-xl p-4 text-center shadow-sm border border-stone-200/50 hover:shadow-md transition-shadow">
            <span class="block text-2xl sm:text-3xl font-bold font-display text-accent-700">{agent.experience_years}+</span>
            <span class="block text-[10px] sm:text-xs text-stone-500 font-semibold uppercase tracking-wider mt-1">Years Experience</span>
          </div>
          
          <div class="bg-white rounded-xl p-4 text-center shadow-sm border border-stone-200/50 hover:shadow-md transition-shadow">
            <span class="block text-2xl sm:text-3xl font-bold font-display text-accent-700">{agent.properties_sold}+</span>
            <span class="block text-[10px] sm:text-xs text-stone-500 font-semibold uppercase tracking-wider mt-1">Properties Sold</span>
          </div>
          
          <div class="bg-white rounded-xl p-4 text-center shadow-sm border border-stone-200/50 hover:shadow-md transition-shadow">
            <span class="block text-2xl sm:text-3xl font-bold font-display text-accent-700">100%</span>
            <span class="block text-[10px] sm:text-xs text-stone-500 font-semibold uppercase tracking-wider mt-1">Client Trust</span>
          </div>
        </div>

        <!-- Action / Call Buttons -->
        <div class="pt-2 flex items-center gap-6 flex-wrap">
          <Button variant="primary" size="md" href="/about/">
            Read Full Profile
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </Button>
          
          <a
            href={`tel:${agent.agent_phone}`}
            class="text-sm font-bold text-stone-800 hover:text-accent-600 transition-colors flex items-center gap-2 group"
          >
            <div class="w-8 h-8 rounded-full bg-stone-100 flex items-center justify-center text-stone-600 group-hover:bg-accent-100 group-hover:text-accent-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.806-5.18-4.156-6.987-6.987l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25Z" />
              </svg>
            </div>
            <span>Call: {agent.agent_phone}</span>
          </a>
        </div>
      </div>
      
    </div>
  </div>
</section>

