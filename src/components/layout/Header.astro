---
import { NAV_LINKS, SITE_NAME, AGENT } from '../../lib/constants';
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const normPath = currentPath.replace(/^\/|\/$/g, '');
  const normHref = href.replace(/^\/|\/$/g, '');
  
  if (normHref === '') {
    return normPath === '';
  }
  return normPath.startsWith(normHref);
};
---

<header class="sticky top-0 z-40 w-full bg-white/80 backdrop-blur-md border-b border-stone-100 shadow-sm">
  <div class="container-site flex h-20 items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="text-2xl font-bold tracking-tight font-display text-stone-900 group-hover:text-accent-600 transition-colors duration-200">
        Premier<span class="text-accent-600 font-medium">Properties</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {NAV_LINKS.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class={`text-sm transition-all duration-200 relative py-1.5 ${
              active
                ? 'text-accent-600 font-semibold after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-accent-600 after:rounded-full'
                : 'text-stone-600 hover:text-accent-600 font-medium'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-4">
      <a href="tel:+919876543210" class="text-sm font-semibold text-stone-700 hover:text-accent-600 transition-colors duration-200 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.806-5.18-4.156-6.987-6.987l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
        </svg>
        <span>+91 98765 43210</span>
      </a>
      <Button variant="primary" size="sm" href="/contact/">
        Get in Touch
      </Button>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-lg border border-stone-200 text-stone-600 hover:bg-stone-50 md:hidden focus:outline-none"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 block">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-20 z-30 hidden border-b border-stone-200 bg-white p-6 shadow-lg md:hidden transition-all duration-300 ease-in-out"
  >
    <div class="flex flex-col gap-6">
      <nav class="flex flex-col gap-3">
        {NAV_LINKS.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`text-base transition-colors px-3 py-2 rounded-lg font-semibold ${
                active
                  ? 'text-accent-700 bg-accent-50/50 border-l-4 border-accent-600'
                  : 'text-stone-800 hover:text-accent-600'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
      <hr class="border-stone-100" />
      <div class="flex flex-col gap-4">
        <a href="tel:+919876543210" class="text-base font-semibold text-stone-800 hover:text-accent-600 transition-colors flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-stone-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.806-5.18-4.156-6.987-6.987l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          <span>+91 98765 43210</span>
        </a>
        <Button variant="primary" size="md" href="/contact/" fullWidth>
          Get in Touch
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      
      if (isExpanded) {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        hamburgerIcon.classList.add('block');
        closeIcon.classList.remove('block');
        closeIcon.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        hamburgerIcon.classList.remove('block');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        closeIcon.classList.add('block');
      }
    });

    // Close menu when clicking links
    const links = mobileMenu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        hamburgerIcon.classList.remove('hidden');
        hamburgerIcon.classList.add('block');
        closeIcon.classList.remove('block');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
