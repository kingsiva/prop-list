---
interface Props {
  googleMapUrl?: string;
  address: string;
  city: string;
}

const { googleMapUrl, address, city } = Astro.props;

// Determine map url for iframe
let iframeUrl = '';
let isEmbeddable = false;

if (googleMapUrl) {
  if (googleMapUrl.includes('google.com/maps/embed') || googleMapUrl.includes('google.com/maps/embed/v1')) {
    iframeUrl = googleMapUrl;
    isEmbeddable = true;
  } else if (googleMapUrl.includes('goo.gl/maps') || googleMapUrl.includes('google.com/maps')) {
    // If it's a share link, let's use the query embed as a fallback
    iframeUrl = `https://maps.google.com/maps?q=${encodeURIComponent(address + ', ' + city)}&output=embed`;
    isEmbeddable = true;
  }
} else {
  // If no URL is provided, generate a fallback embed based on address + city
  iframeUrl = `https://maps.google.com/maps?q=${encodeURIComponent(address + ', ' + city)}&output=embed`;
  isEmbeddable = true;
}

const externalMapUrl = googleMapUrl || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address + ', ' + city)}`;
---

<div class="bg-white rounded-xl border border-stone-200/60 p-6 shadow-sm">
  <div class="flex items-center justify-between mb-5 flex-wrap gap-2">
    <h3 class="text-lg font-bold font-display text-stone-900">Location & Neighborhood</h3>
    
    <a
      href={externalMapUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-semibold text-accent-700 hover:text-accent-800 transition-colors flex items-center gap-1.5"
    >
      <span>Open in Google Maps</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
      </svg>
    </a>
  </div>

  <p class="text-sm text-stone-600 mb-4 flex items-start gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-stone-400 shrink-0 mt-0.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
    </svg>
    <span>{address}, {city}</span>
  </p>

  <!-- Map Iframe Wrapper -->
  {isEmbeddable ? (
    <div class="relative w-full rounded-lg overflow-hidden border border-stone-200 shadow-inner bg-stone-100 aspect-video md:h-[400px]">
      <iframe
        src={iframeUrl}
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Google Map for ${address}`}
        class="absolute inset-0"
      ></iframe>
    </div>
  ) : (
    <div class="flex flex-col items-center justify-center p-8 border border-dashed border-stone-200 rounded-lg text-center bg-stone-50">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-stone-400 mb-2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.75 3h-7.5A2.25 2.25 0 013 18V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v12a2.25 2.25 0 01-2.25 2.25zm-7.5 0h7.5" />
      </svg>
      <h4 class="text-sm font-semibold text-stone-800">Map View Available Externally</h4>
      <p class="text-xs text-stone-500 max-w-xs mt-1 mb-4">A map could not be embedded directly. You can view the location on Google Maps by clicking the button below.</p>
      <a
        href={externalMapUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 border border-stone-300 text-xs font-semibold rounded-lg text-stone-700 bg-white hover:bg-stone-50 hover:border-stone-400 transition-colors"
      >
        <span>View on Google Maps</span>
      </a>
    </div>
  )}
</div>
