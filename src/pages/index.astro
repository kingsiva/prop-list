---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedListings from '../components/home/FeaturedListings.astro';
import LatestListings from '../components/home/LatestListings.astro';
import AgentIntro from '../components/home/AgentIntro.astro';
import Testimonials from '../components/home/Testimonials.astro';
import CTASection from '../components/home/CTASection.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/constants';
---

<BaseLayout>
  <!-- SEO tags injection -->
  <Fragment slot="head">
    <SEOHead
      title={SITE_NAME}
      description={SITE_DESCRIPTION}
    />
  </Fragment>

  <!-- Homepage Sections -->
  <Hero />
  <FeaturedListings />
  <LatestListings />
  <AgentIntro />
  <Testimonials />
  <CTASection />
</BaseLayout>
