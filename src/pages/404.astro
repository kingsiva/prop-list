---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SEOHead from '../components/seo/SEOHead.astro';
---

<BaseLayout title="404 Page Not Found">
  <Fragment slot="head">
    <SEOHead
      title="Page Not Found"
      description="The page you are looking for does not exist."
      noindex={true}
    />
  </Fragment>

  <div class="min-h-[70vh] flex items-center justify-center bg-stone-50 py-16 px-6">
    <div class="max-w-md w-full text-center space-y-6">
      <!-- Icon/Visual -->
      <div class="inline-flex h-20 w-20 items-center justify-center rounded-full bg-accent-50 text-accent-700 border border-accent-100 shadow-sm animate-bounce">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
        </svg>
      </div>

      <div class="space-y-2">
        <h1 class="text-6xl font-black font-display text-stone-900 tracking-tight">404</h1>
        <h2 class="text-xl font-bold font-display text-stone-800">Page Not Found</h2>
        <p class="text-stone-500 text-sm leading-relaxed max-w-sm mx-auto">
          The property, listing, or page you are looking for has been moved, renamed, or is temporarily unavailable.
        </p>
      </div>

      <div class="pt-4 flex flex-col sm:flex-row justify-center items-center gap-3">
        <Button variant="primary" href="/" class="w-full sm:w-auto">
          Go Back Home
        </Button>
        <Button variant="outline" href="/properties/" class="w-full sm:w-auto">
          Browse All Properties
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
