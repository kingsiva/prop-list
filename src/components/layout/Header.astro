---
import { NAV_LINKS, SITE_NAME, AGENT } from '../../lib/constants';
import Button from '../ui/Button.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const normPath = currentPath.replace(/^\/|\/$/g, '');
  const normHref = href.replace(/^\/|\/$/g, '');
  
  if (normHref === '') {
    return normPath === '';
  }
  return normPath.startsWith(normHref);
};
---

<header class="sticky top-0 z-40 w-full bg-white/80 backdrop-blur-md border-b border-stone-100 shadow-sm">
  <div class="container-site flex h-20 items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="text-2xl font-bold tracking-tight font-display text-stone-900 group-hover:text-accent-600 transition-colors duration-200">
        Premier<span class="text-accent-600 font-medium">Properties</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {NAV_LINKS.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class={`text-sm transition-all duration-200 relative py-1.5 ${
              active
                ? 'text-accent-600 font-semibold after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-accent-600 after:rounded-full'
                : 'text-stone-600 hover:text-accent-600 font-medium'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-4">
      <a href="tel:+919876543210" class="text-sm font-semibold text-stone-700 hover:text-accent-600 transition-colors duration-200 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.806-5.18-4.156-6.987-6.987l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
        </svg>
        <span>+91 98765 43210</span>
      </a>
      <Button variant="primary" size="sm" href="/contact/">
        Get in Touch
      </Button>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-lg text-stone-700 hover:text-accent-600 md:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent-500 transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <!-- Modern animated asymmetrical 2-bar hamburger -->
      <div class="relative flex flex-col justify-between w-5 h-2.5">
        <span id="line-top" class="w-full h-0.5 bg-current rounded-full"></span>
        <span id="line-bottom" class="w-3/4 h-0.5 bg-current rounded-full self-end"></span>
      </div>
    </button>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-20 z-30 hidden border-b border-stone-200 bg-white p-6 shadow-lg md:hidden transition-all duration-300 ease-in-out"
  >
    <div class="flex flex-col gap-6">
      <nav class="flex flex-col gap-3">
        {NAV_LINKS.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`text-base transition-colors px-3 py-2 rounded-lg font-semibold border ${
                active
                  ? 'text-accent-700 bg-accent-50/70 border-accent-100/60'
                  : 'text-stone-800 border-transparent hover:text-accent-600'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
      <hr class="border-stone-100" />
      <div class="flex flex-col gap-4">
        <a href="tel:+919876543210" class="text-base font-semibold text-stone-800 hover:text-accent-600 transition-colors flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-stone-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.806-5.18-4.156-6.987-6.987l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          <span>+91 98765 43210</span>
        </a>
        <Button variant="primary" size="md" href="/contact/" fullWidth>
          Get in Touch
        </Button>
      </div>
    </div>
  </div>
</header>

<style>
  /* Modern dynamic hamburger transitions */
  #line-top, #line-bottom {
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), width 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease, background-color 0.25s ease;
  }
  
  /* Open state transformations */
  [aria-expanded="true"] #line-top {
    transform: translateY(4px) rotate(45deg);
  }
  
  [aria-expanded="true"] #line-bottom {
    transform: translateY(-4px) rotate(-45deg);
    width: 100% !important;
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      
      if (isExpanded) {
        mobileMenu.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
      }
    });

    // Close menu when clicking links
    const links = mobileMenu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
