---
import type { CollectionEntry } from 'astro:content';
import { PROPERTY_FEATURES } from '../../lib/constants';

interface Props {
  property: CollectionEntry<'properties'>;
}

const { property } = Astro.props;
const data = property.data || (property as any);

// Map of location features from Constants
const locationFeatureLabels = new Map(
  PROPERTY_FEATURES.map((item) => [item.value, item.label])
);

// Map of boolean fields to readable labels
const AMENITY_LABELS: Record<string, string> = {
  road_access: 'Road Access Available',
  corner_plot: 'Corner Plot',
  construction_permission: 'Construction Permission',
  approved_layout: 'Approved Layout Plan',
  dtcp_approved: 'DTCP Approved Layout',
  rera_approved: 'RERA Registered',
  water_connection: 'Water Connection',
  electricity_connection: 'Electricity Connection',
  drainage_connection: 'Drainage Connection',
  fencing: 'Plot Fencing Done',
  boundary_wall: 'Boundary Wall Built',
  agricultural_land: 'Suitable for Agriculture',
  residential_land: 'Suitable for Residential Use',
  commercial_land: 'Suitable for Commercial Use',
  water_supply: 'Corporation/Panchayat Water Supply',
  electricity: 'Electricity Connection Ready',
  drainage: 'Drainage Network',
  borewell: 'Private Borewell',
  septic_tank: 'Septic Tank Installed',
  solar_power: 'Solar Power System',
  compound_wall: 'Gated Compound Wall',
  gated_property: 'Gated Community/Property',
  lift_available: 'Passenger Lift Access',
  power_backup: 'Generator Power Backup',
  security: '24/7 Security Guard',
  gym: 'Equipped Gymnasium',
  swimming_pool: 'Swimming Pool',
  clubhouse: 'Community Clubhouse',
  children_play_area: 'Children\'s Play Area',
  visitor_parking: 'Visitor Parking Slots',
  generator: 'Silent Backup Generator',
  internet_connectivity: 'High-speed Fiber Internet',
  conference_room: 'Conference / Meeting Room',
  meeting_room: 'Private Meeting Space',
  reception_area: 'Visitor Reception Area',
  cafeteria: 'In-house Cafeteria',
  warehouse_space: 'Attached Warehouse Space',
  loading_area: 'Dedicated Loading Dock',
  truck_access: 'Heavy Truck Access',
  fire_safety_system: 'Fire Alarm & Sprinkler System',
  occupancy_certificate: 'Occupancy Certificate (OC)',
  commercial_license: 'Commercial Trade License Ready',
  storage_room: 'Stock Storage Room',
  washroom: 'Private Washroom',
  display_front: 'High-visibility Glass Frontage',
  main_road_facing: 'Main Road Frontage',
};

// 1. Gather location features
const activeLocationFeatures = (data.features || [])
  .map((f: string) => locationFeatureLabels.get(f as any))
  .filter(Boolean) as string[];

// 2. Gather active amenities (boolean fields set to true)
const activeAmenities: string[] = [];
Object.entries(AMENITY_LABELS).forEach(([key, label]) => {
  if (data[key as keyof typeof data] === true) {
    activeAmenities.push(label);
  }
});

const hasAnyFeatures = activeLocationFeatures.length > 0 || activeAmenities.length > 0;
---

{hasAnyFeatures && (
  <div class="bg-white rounded-xl border border-stone-200/60 p-6 shadow-sm">
    <h3 class="text-lg font-bold font-display text-stone-900 mb-6">Features & Amenities</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Property Amenities -->
      {activeAmenities.length > 0 && (
        <div class="space-y-4">
          <h4 class="text-sm font-semibold uppercase tracking-wider text-stone-500">Property Details & Amenities</h4>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {activeAmenities.map((amenity) => (
              <li class="flex items-center gap-2.5 text-sm text-stone-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-accent-600 shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <span>{amenity}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Location/Connectivity Features -->
      {activeLocationFeatures.length > 0 && (
        <div class="space-y-4">
          <h4 class="text-sm font-semibold uppercase tracking-wider text-stone-500">Location Advantages</h4>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {activeLocationFeatures.map((feature) => (
              <li class="flex items-center gap-2.5 text-sm text-stone-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-accent-600 shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
)}
