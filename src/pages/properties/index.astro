---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEOHead from '../../components/seo/SEOHead.astro';
import PropertyFilters from '../../components/property/PropertyFilters.astro';
import PropertyCard from '../../components/property/PropertyCard.astro';
import { SITE_NAME } from '../../lib/constants';

// Fetch all listings
const properties = await getCollection('properties');

// Extract unique cities (sorted alphabetically)
const uniqueCities = [...new Set(properties.map((p) => p.data.city))]
  .filter(Boolean)
  .sort((a, b) => a.localeCompare(b));

// Find max price (defaults to 1 Crore if no listings)
const maxPrice = properties.reduce((max, p) => p.data.price > max ? p.data.price : max, 10000000);
---

<BaseLayout title="Explore Properties" description="Browse residential plots, luxury villas, modern apartments, and premium retail spaces.">
  <Fragment slot="head">
    <SEOHead
      title="Explore Listings"
      description={`Find residential, commercial, and land properties for sale and rent in Tamil Nadu. Browse active listings on ${SITE_NAME}.`}
    />
  </Fragment>

  <div class="py-12 bg-stone-50 border-b border-stone-200/50">
    <div class="container-site">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div class="space-y-2">
          <h1 class="text-4xl font-bold font-display text-stone-900 tracking-tight">Search Properties</h1>
          <p class="text-stone-500 text-sm sm:text-base max-w-xl">
            Filter through our direct real estate catalog. All properties are verified, clear-titled, and managed directly by our agent.
          </p>
        </div>
        
        <!-- Mobile Filter Button Toggle -->
        <button
          type="button"
          id="mobile-filter-toggle"
          class="md:hidden flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-stone-900 text-white font-medium text-sm shadow cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent-500"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
          </svg>
          <span>Show Filters</span>
        </button>
      </div>

      <!-- Main Layout: Sidebar & Grid -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        
        <!-- Filter Sidebar -->
        <div id="filter-sidebar-wrapper" class="hidden md:block md:col-span-4 lg:col-span-3 sticky top-24 z-20">
          <PropertyFilters cities={uniqueCities} maxPrice={maxPrice} />
        </div>

        <!-- Listing Grid -->
        <div class="md:col-span-8 lg:col-span-9 space-y-6">
          <!-- Total Count Header -->
          <div class="flex justify-between items-center pb-3 border-b border-stone-200/60 text-xs font-semibold text-stone-400 uppercase tracking-widest">
            <span id="properties-count">{properties.length} Properties found</span>
            <span>Static Verified</span>
          </div>

          <!-- The actual card grid filtered client side -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full" data-property-listing-grid>
            {properties.map((property) => (
              <div
                data-property-card
                data-type={property.data.property_type}
                data-listing={property.data.listing_type}
                data-price={property.data.price}
                data-beds={property.data.bedrooms || 0}
                data-location={property.data.location.toLowerCase()}
                data-city={property.data.city.toLowerCase()}
                data-title={property.data.title.toLowerCase()}
                class="block"
              >
                <PropertyCard property={property} />
              </div>
            ))}
          </div>

          <!-- Fallback empty state -->
          <div id="grid-empty-state" class="hidden flex flex-col items-center justify-center text-center py-20 px-6 bg-white rounded-xl border border-dashed border-stone-200">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-stone-50 text-stone-400 mb-4 border border-stone-100">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-stone-900 mb-1">No Matching Properties</h3>
            <p class="text-sm text-stone-500 max-w-xs leading-relaxed">No listings fit your selected filters. Click "Reset All" to start your search again.</p>
          </div>
        </div>
        
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function setupMobileToggle() {
    const toggleBtn = document.getElementById('mobile-filter-toggle');
    const filterWrapper = document.getElementById('filter-sidebar-wrapper');

    if (toggleBtn && filterWrapper) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = filterWrapper.classList.contains('hidden');
        if (isHidden) {
          filterWrapper.classList.remove('hidden', 'md:block');
          filterWrapper.classList.add('block', 'fixed', 'inset-x-0', 'bottom-0', 'top-20', 'bg-white', 'p-6', 'overflow-y-auto');
          toggleBtn.querySelector('span').textContent = 'Hide Filters';
        } else {
          filterWrapper.classList.add('hidden', 'md:block');
          filterWrapper.classList.remove('block', 'fixed', 'inset-x-0', 'bottom-0', 'top-20', 'bg-white', 'p-6', 'overflow-y-auto');
          toggleBtn.querySelector('span').textContent = 'Show Filters';
        }
      });
      
      // Close filter on clicks on buttons that trigger layout refreshes
      const resetBtn = document.getElementById('filter-reset-btn');
      resetBtn?.addEventListener('click', () => {
        if (window.innerWidth < 768) {
          filterWrapper.classList.add('hidden', 'md:block');
          filterWrapper.classList.remove('block', 'fixed', 'inset-x-0', 'bottom-0', 'top-20', 'bg-white', 'p-6', 'overflow-y-auto');
          toggleBtn.querySelector('span').textContent = 'Show Filters';
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', setupMobileToggle);
  document.addEventListener('astro:after-swap', setupMobileToggle);
</script>
