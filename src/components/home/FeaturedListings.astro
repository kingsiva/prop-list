---
import { getCollection } from 'astro:content';
import PropertyGrid from '../property/PropertyGrid.astro';
import Button from '../ui/Button.astro';

// Fetch properties and filter by featured
const properties = await getCollection('properties');
const featuredProperties = properties
  .filter((p) => p.data.featured === true && p.data.status === 'available')
  .slice(0, 3); // Limit to top 3 featured listings for home page
---

{featuredProperties.length > 0 && (
  <section class="section-spacing bg-white">
    <div class="container-site">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 md:mb-12">
        <div class="space-y-2 max-w-xl">
          <h2 class="text-3xl md:text-4xl font-bold font-display text-stone-900 tracking-tight">
            Featured Listings
          </h2>
          <p class="text-stone-500 text-sm sm:text-base leading-relaxed">
            Handpicked premium property selections featuring excellent locations, building qualities, and investment value.
          </p>
        </div>
        
        <div class="shrink-0 hidden md:block">
          <Button variant="outline" size="sm" href="/properties/">
            View All Properties
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </Button>
        </div>
      </div>

      <!-- Grid -->
      <PropertyGrid properties={featuredProperties} columns={3} />

      <!-- Mobile Button -->
      <div class="mt-8 text-center md:hidden">
        <Button variant="outline" size="md" href="/properties/" fullWidth>
          View All Properties
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </Button>
      </div>
    </div>
  </section>
)}
