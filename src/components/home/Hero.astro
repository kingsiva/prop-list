---
import { Picture } from 'astro:assets';
import SearchBar from '../search/SearchBar.astro';
import heroBg from '../../assets/images/hero-bg.png';
---

<section class="relative bg-stone-950 overflow-hidden py-12 md:py-20 lg:py-24 flex items-center min-h-[600px] lg:min-h-[700px]">
  <!-- Subtle decorative gradients -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,var(--color-accent-950)/40,transparent_60%)] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_10%_80%,var(--color-stone-900)/60,transparent_50%)] pointer-events-none"></div>

  <!-- Background Grid Pattern -->
  <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:30px_30px] [mask-image:radial-gradient(ellipse_at_center,black_60%,transparent_100%)] pointer-events-none"></div>

  <div class="container-site relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Content & Search -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Accent tag line -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-950/60 border border-accent-500/30 text-accent-300 text-xs font-semibold uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-500 animate-pulse"></span>
          <span>Premier Real Estate Consultant</span>
        </div>

        <!-- Main Display Heading -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold font-display text-white tracking-tight leading-[1.1] text-balance">
          Find Your Perfect <span class="text-accent-400 font-medium">Property</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-stone-300 max-w-2xl font-sans leading-relaxed text-balance">
          Your trusted partner for premium residential, commercial & land properties in Tamil Nadu. Curated listings with absolute legal clarity and seamless transactions.
        </p>

        <!-- Embed Search Bar -->
        <div class="pt-2 max-w-2xl w-full">
          <SearchBar />
        </div>

        <!-- Bottom Quick Info -->
        <div class="pt-4 flex flex-wrap gap-x-6 gap-y-3 text-xs text-stone-400 font-medium">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-accent-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            100% Legal Clearance
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-accent-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Direct Agent Support
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-accent-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 16c1.22 0 2.2-.746 2.2-1.667 0-.918-.98-1.667-2.2-1.667z" />
            </svg>
            Zero Brokerage Selects
          </span>
        </div>
      </div>

      <!-- Right Column: Visual Showcase Frame -->
      <div class="lg:col-span-5 relative w-full max-w-lg lg:max-w-none mx-auto lg:mx-0">
        <!-- Ambient back-glow -->
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-accent-500 to-warm-500 opacity-20 blur-xl"></div>
        
        <div class="relative bg-stone-900 border border-stone-800 rounded-2xl overflow-hidden p-2 shadow-2xl">
          <div class="aspect-square sm:aspect-[4/3] lg:aspect-square rounded-xl overflow-hidden bg-stone-950 relative group">
            <Picture
              src={heroBg}
              widths={[400, 600, 800]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 40vw"
              formats={['avif', 'webp']}
              alt="Premium residential property listing"
              class="w-full h-full object-cover transition-transform duration-[4000ms] ease-out group-hover:scale-105"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-transparent to-transparent opacity-60"></div>
            
            <!-- Dynamic floating detail label -->
            <div class="absolute bottom-4 left-4 right-4 bg-stone-950/80 backdrop-blur-md border border-white/10 rounded-xl p-3 flex justify-between items-center shadow-lg">
              <div>
                <span class="block text-[10px] text-accent-400 uppercase tracking-widest font-semibold">Featured Property</span>
                <span class="block text-sm font-bold text-white mt-0.5">Luxury Contemporary Villa</span>
              </div>
              <div class="bg-accent-600 text-white text-[10px] font-bold px-2 py-1 rounded">
                VERIFIED
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

